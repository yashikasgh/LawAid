# =============================================================================
# LawAid — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets to git.
# =============================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# For local development, SQLite fallback is used automatically when PG is absent.
POSTGRES_USER=lawaid
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=lawaid
DATABASE_URL=postgresql://lawaid:changeme_strong_password@localhost:5432/lawaid

# ── MongoDB / GridFS ─────────────────────────────────────────────────────────
# Required for file storage (FIR uploads, PDFs). Skipped if not running.
MONGO_URL=mongodb://localhost:27017/lawaid

# ── Redis (optional — not currently used by backend) ─────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT Authentication ────────────────────────────────────────────────────────
# IMPORTANT: Use a long random string in production (e.g. 64-char hex).
JWT_SECRET=replace-with-at-least-32-char-random-secret
JWT_EXPIRY_HOURS=8

# ── Groq LLM (primary provider) ──────────────────────────────────────────────
# Get your key at https://console.groq.com
# IMPORTANT: Rotate the key if it was ever committed to git.
GROQ_API_KEY=your_groq_api_key_here
# Use a Groq model that supports JSON mode (llama3-70b-8192 is recommended)
GROQ_MODEL=llama3-70b-8192

# ── Optional LLM Fallback Providers ──────────────────────────────────────────
# OpenRouter (https://openrouter.ai) — optional fallback
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/auto

# Gemini (https://aistudio.google.com) — optional fallback
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Cerebras — optional fallback
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=llama3.1-70b
